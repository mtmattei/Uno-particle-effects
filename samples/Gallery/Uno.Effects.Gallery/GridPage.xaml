<Page x:Class="Uno.Effects.Gallery.GridPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PaperBrush}">
  <ScrollViewer Padding="0,0,0,72">
    <StackPanel Padding="56,52,56,0" MaxWidth="1440">

      <!-- Header -->
      <Grid Margin="0,0,0,20">
        <TextBlock Text="Particles" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Bottom" />
        <StackPanel Orientation="Horizontal" Spacing="36" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <TextBlock x:Name="CountLabel" Style="{StaticResource EyebrowStyle}" Text="8 STUDIES" />
          <TextBlock Style="{StaticResource EyebrowStyle}" Text="HOVER A TILE TO ANIMATE" />
        </StackPanel>
      </Grid>
      <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,0,0,24" />

      <!-- Filters -->
      <ItemsControl x:Name="ChipHost" Margin="0,0,0,32">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- The board -->
      <Grid x:Name="TileGrid" ColumnSpacing="16" RowSpacing="22" />

      <TextBlock x:Name="EmptyLabel"
                 Style="{StaticResource BodyStyle}"
                 Text="Nothing in the catalog matches that filter."
                 Visibility="Collapsed"
                 Margin="0,8,0,0" />

    </StackPanel>
  </ScrollViewer>
</Page>
