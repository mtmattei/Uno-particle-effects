// Plasma — four interfering sine fields, one of them radial.
// Ported from the study sheet, where it was a 28x28 grid of filled cells; as a
// shader it is continuous and costs the same at any size.

uniform float2 uResolution;
uniform float  uTime;
uniform float4 uColor;

half4 main(float2 position)
{
    float2 uv = position / uResolution;
    float t = uTime * 0.6;

    float v = sin(uv.x * 6.0 + t)
            + sin((uv.y * 6.0 + t) * 0.8)
            + sin((uv.x + uv.y) * 5.0 + t * 1.3)
            + sin(length(uv - float2(0.5, 0.5)) * 10.0 - t * 2.0);

    // The four waves sum into [-4, 4]; squaring after the remap deepens the
    // troughs so the bright ridges read as ridges.
    float a = (v + 4.0) / 8.0;
    a = a * a * 0.9 * uColor.a;

    return half4(half3(uColor.rgb * a), half(a));
}
