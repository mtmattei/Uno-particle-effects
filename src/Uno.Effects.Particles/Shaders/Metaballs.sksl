// Metaballs — an inverse-square field summed over up to eight blobs, with a
// hard core and a soft rim so the merges read clearly.
// Blobs are packed as (x, y, radius); a radius of 0 switches a blob off.

const int MAX_BALLS = 8;

uniform float2 uResolution;
uniform float3 uBalls[MAX_BALLS];
uniform float  uThreshold;
uniform float4 uColor;

half4 main(float2 position)
{
    float field = 0.0;

    for (int i = 0; i < MAX_BALLS; ++i)
    {
        float2 delta = position - uBalls[i].xy;
        float radius = uBalls[i].z;
        field += radius * radius / (dot(delta, delta) + 1.0);
    }

    float rim = uThreshold * 0.6;
    float a = 0.0;

    if (field > uThreshold)
    {
        a = min(1.0, 0.5 + (field - uThreshold) * 0.5);
    }
    else if (field > rim)
    {
        a = (field - rim) * 0.6;
    }

    a = a * uColor.a;

    return half4(half3(uColor.rgb * a), half(a));
}
